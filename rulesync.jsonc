{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": {
    "claudecode": {
      "rules": {
        "ruleDiscoveryMode": "explicit"
      },
      "mcp": true,
      "permissions": true,
      "skills": true
    },
    "cursor": ["rules"],
    "agentsskills": ["skills"],
    "codexcli": ["rules"]
  },
  "outputRoots": ["."],
  "delete": false,
  "gitignoreTargetsOnly": true
}
